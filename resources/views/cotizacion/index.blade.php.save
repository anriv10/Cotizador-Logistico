        <!-- Panel de Precio en Tiempo Real -->
        <div class="mt-8 bg-slate-50 border border-slate-200 rounded-lg p-6 text-right">
            <h3 class="text-xl font-bold text-slate-800 mb-2">Desglose de Cotización</h3>
            <div class="text-sm text-slate-600 mb-1">Subtotal: $<span id="lbl_subtotal">0.00</span></div>
            <div class="text-sm text-red-600 font-bold mb-3 hidden" id="div_custodia">
                + Custodia Automática (Por Seguridad): $<span id="lbl_custodia">0.00</span>
            </div>
            <div class="text-3xl font-black text-blue-600 border-t pt-2">
                Total: $<span id="lbl_total">0.00</span> <span class="text-sm font-normal text-slate-500">MXN</span>
            </div>
        </div>

        <button type="submit" class="mt-6 w-full bg-blue-600 text-white font-bold py-4 rounded hover:bg-blue-700 transition shadow-lg text-lg">
            📄 Guardar y Generar PDF
        </button>
    </form>
</div>

<!-- Lógica de Cálculo en Tiempo Real -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const inputs = document.querySelectorAll('.trigger-calc');
    
    inputs.forEach(input => {
        input.addEventListener('input', calcularPrecio);
        input.addEventListener('change', calcularPrecio);
    });

    async function calcularPrecio() {
        const tipoContenedor = document.getElementById('tipo_contenedor').value;
        const distancia = document.getElementById('distancia_km').value;
        const peso = document.getElementById('peso_toneladas').value;

        // Solo consultamos al servidor si tenemos los 3 datos requeridos
        if (!tipoContenedor || !distancia || !peso) return;

        try {
            const response = await fetch("{{ route('cotizacion.calcular') }}", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-CSRF-TOKEN": "{{ csrf_token() }}"
                },
                body: JSON.stringify({
                    tipo_contenedor: tipoContenedor,
                    distancia_km: distancia,
                    peso_toneladas: peso
                })
            });

            if (!response.ok) throw new Error("Error en el cálculo");

            const data = await response.json();

            // Actualizar la pantalla con los datos del servidor
            document.getElementById('lbl_subtotal').innerText = parseFloat(data.subtotal).toFixed(2);
            document.getElementById('lbl_total').innerText = parseFloat(data.total).toFixed(2);

            const divCustodia = document.getElementById('div_custodia');
            if (data.requiere_custodia) {
                document.getElementById('lbl_custodia').innerText = parseFloat(data.costo_custodia).toFixed(2);
                divCustodia.classList.remove('hidden');
            } else {
                divCustodia.classList.add('hidden');
            }

        } catch (error) {
            console.error("Error contactando al servidor:", error);
        }
    }
});
</script>
@endsection
