                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Peso (Toneladas)</label>
                        <input type="number" step="0.1" name="peso_toneladas" id="peso_toneladas" class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-500 trigger-calc" required>
